#!/bin/sh
# Device : host_elakhfif-3
# Part   : P3, BGP EVPN
#
# Not run at boot: the evaluation starts a host with no IP address, to prove
# it is learned by its MAC alone. Run it by hand afterwards, in the console:
#   sh /etc/network/_elakhfif-3_host
#
# A computer with one address. All hosts are in 20.1.1.0/24 and believe they
# share one local network, thanks to VXLAN 10.
# mtu 1450: VXLAN adds 50 bytes around each packet, and links carry 1500 at most.
ip addr flush dev eth0
ip addr add 20.1.1.3/24 dev eth0
ip link set eth0 mtu 1450
ip link set eth0 up

# Say hello once, so the router sees our MAC address and BGP can publish it.
arping -U -c 2 -I eth0 20.1.1.3 >/dev/null 2>&1
